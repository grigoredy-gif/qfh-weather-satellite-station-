	)
	(text "Lr1g_x, Lr2g_x, Lr3g_x: 1.5 nH for the path from each inductor's grounded pad through its via to the ground plane."
		(exclude_from_sim no)
		(at 15.24 241.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b69f188a-c1fb-55e2-b8b2-7ea3070712db")
	)
	(text "They pull each tuned circuit about 1.5 MHz down; the capacitor values above are chosen with them in place."
		(exclude_from_sim no)
		(at 15.24 243.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d0cff5d4-53ad-5502-9ec3-76b186585ba3")
	)
	(text "Bypass rule at VHF: never a small and a large capacitor in parallel on the same node. With their via inductance"
		(exclude_from_sim no)
		(at 15.24 246.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5adf532d-fc01-5002-af82-0b99e5837bc1")
	)
	(text "(about 0.7 nH each) a 1 nF and a 100 nF form a parallel resonance near 135 MHz. The emitter of the LNA therefore"
		(exclude_from_sim no)
		(at 15.24 249.46 0)
		(effects
			(font
				(size 1.27 1.27)
