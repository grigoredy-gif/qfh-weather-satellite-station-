	(text "Second mixer: 12.9 MHz in, 1.418 MHz out into tuned circuit T5"
		(exclude_from_sim no)
		(at 15.24 22.86 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "141c7508-aac7-5a94-89df-0e6335b32ef1")
	)
	(text "Double-balanced (Gilbert cell) from six MMBT3904, so the 14.3 MHz LO cancels at the output."
		(exclude_from_sim no)
		(at 15.24 27.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f9664fad-42a3-5bd2-acc7-e056c2b37124")
	)
	(text "(A single-balanced version leaked 30 mV of LO onto T5 and captured the limiter on weak signals.)"
		(exclude_from_sim no)
		(at 15.24 30.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5aea024c-03de-5492-8e7b-f85c64a1507d")
	)
	(text "Nodes: m2in (signal in), lo2 (14.318 MHz drive, also the DC-biased base node of Qs1 and Qs4; the oscillator block couples in through its own capacitor), t5 (output: feeds T5 of the second-IF strip), vcc, vb"
		(exclude_from_sim no)
		(at 15.24 32.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c572fe37-66bd-55d2-b6cb-c161499107ac")
	)
	(text "Qm1/Qm2 turn the input voltage into two opposite currents; Qs1..Qs4 swap them at the LO2 rate."
		(exclude_from_sim no)
		(at 15.24 35.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4ce0bde8-53df-5cd4-8374-368075c61cef")
	)
	(text "Re1, Re2 = 100 ohm (they were 220): 4 dB more conversion gain, to make up for the gain taken out of the first-IF"
		(exclude_from_sim no)
		(at 15.24 38.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5d83d3b7-0d80-5790-9728-ff63b2b5554b")
	)
	(text "strip. This mixer sits in neither strip's feedback loop, so the gain is safe here."
		(exclude_from_sim no)
		(at 15.24 41.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5142af40-3d9c-5a49-bf79-71aaa6b8500f")
	)
