	(text "Layout rules for this sheet (from the design log)"
		(exclude_from_sim no)
		(at 15.24 22.86 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "d8e4608e-01e0-57b2-bd3c-0ee9b7b2cec4")
	)
	(text "Rule 4: node 'eq' (the two squarer emitters and Rqs) as small as possible, under 1 pF."
		(exclude_from_sim no)
		(at 15.24 27.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "da161c06-d6f1-50c3-a467-87a178b50985")
	)
	(text "Rule 6: spare capacitor positions on TA and TB (value 'spare', not fitted)."
		(exclude_from_sim no)
		(at 15.24 30.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "25a0ac1d-bf3b-5a8e-a34f-2132a0a51320")
	)
	(text "Rule 8: the collector of Qq1 reaches Cfq2 within about 4 mm of track (8 nH there makes the pair oscillate)."
		(exclude_from_sim no)
		(at 15.24 32.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fa908c15-f068-5e40-94fe-f312f21c31e6")
	)
	(text "X5 stage: follower, squarer pair and two tuned circuits at 125 MHz"
		(exclude_from_sim no)
		(at 15.24 37.76 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "8c2824a3-681a-512c-b718-adc3a4015fe4")
	)
	(text "Nodes: osc25 (25 MHz sine in, about 0.5 V peak), lo1 (125 MHz out, drives the first mixer), vcc"
		(exclude_from_sim no)
		(at 15.24 42.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6ef5a6d7-e26c-5b7f-9765-ffe20b9f8cd3")
	)
	(text "Follower (S9018, about 3 mA): loads the crystal lightly and drives the squarer from a low impedance."
		(exclude_from_sim no)
		(at 15.24 45.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c414d036-2895-5b18-ad9f-389a65772805")
	)
	(text "Rfs, Rf1 and the snubber Rsnq + Csnq are there against UHF parasitic oscillation (base stopper, isolation, damped bypass)."
		(exclude_from_sim no)
		(at 15.24 47.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "02d198ae-100b-5a7f-a9dd-6293068e47ee")
	)
	(text "Squarer (two 2SC3356): its tail is a current source (Qqt, about 7 mA), so both transistors carry the same"
		(exclude_from_sim no)
		(at 15.24 50.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b4308e96-921d-5780-a4fb-5eb0417ee200")
	)
	(text "current when they are on. Both bases get the same DC through equal 680 ohm resistors, so the"
		(exclude_from_sim no)
		(at 15.24 53.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4797d0d9-3386-5084-a8d4-1c5248a47223")
	)
	(text "pair switches at the zero crossings of the sine and its current is a 50 % square wave (odd harmonics only)."
		(exclude_from_sim no)
		(at 15.24 56.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "75d020d6-bcc2-5a45-a7b1-d068bf233764")
	)
	(text "The output is taken from Qq2, whose base is grounded for AC: its current pulse is flat-topped."
		(exclude_from_sim no)
		(at 15.24 59.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a49c58ad-14c6-53dc-b41a-475c4c07f187")
	)
	(text "Rqs (47 ohm) sits between the emitter node eq and the current source. Without it the pair can oscillate near"
		(exclude_from_sim no)
		(at 15.24 61.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "65c8b98f-0dbf-5b02-8f1f-17db026ac02c")
	)
	(text "1.7 GHz through the package lead inductances once the stray capacitance on eq passes about 1 pF (rx2_m1)."
		(exclude_from_sim no)
		(at 15.24 64.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2a9c4821-7285-5a54-a647-166e612f4e8e")
	)
	(text "Layout: keep node eq as small as possible (the two emitters and Rqs close together)."
		(exclude_from_sim no)
		(at 15.24 67.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2dbcdb02-959c-5b9f-852b-c69b91b113a0")
	)
	(text "Voq is not a part: it stands for the base-emitter mismatch of the two squarer transistors (see rx2_b4)."
		(exclude_from_sim no)
		(at 15.24 70.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e03eadf8-823a-511b-9976-1de4d72c0452")
	)
	(text "TA and TB (68 nH) pick out the fifth harmonic; they are coupled through the shared 330 pF Cmab."
		(exclude_from_sim no)
		(at 15.24 73.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1d96af9b-78a3-57aa-b857-852175867edb")
	)
	(text "Elements ending in _x are layout estimates (board stray, via inductance), not parts."
		(exclude_from_sim no)
		(at 15.24 75.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "150e0719-230e-567a-a6a8-fb5622383e42")
	)
