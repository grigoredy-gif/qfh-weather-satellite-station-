	(lib_symbols)
	(text "QFH 137 MHz weather-satellite receiver, version 2: all discrete, assembled by JLCPCB"
		(exclude_from_sim no)
		(at 205 30 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left top)
		)
		(uuid "d87926d6-8881-5ba5-9f50-35c86d85deb7")
	)
	(text "Signal: antenna 137.9 MHz -> 1 front end -> 4 mixer 1 (LO 125 MHz from 2 and 3) -> 5 first IF 12.9 MHz"
		(exclude_from_sim no)
		(at 205 35.28 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "453d08cd-e441-5c71-845c-6d97979e5577")
	)
	(text "-> 7 mixer 2 (LO 14.318 MHz from 6) -> 8 second IF 1.418 MHz, limiter, detector -> 9 audio -> ESP32 DevKitC, GPIO36."
		(exclude_from_sim no)
		(at 205 38.88 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "10fc4419-eef0-5e22-b08b-0cff42b033e2")
	)
	(text "Power: 10 regulator (rail VCC, 3.3 V: copies the DevKitC's 3V3 pin, fed from its 5V pin), 11 the bias references vb and vbd."
		(exclude_from_sim no)
		(at 205 42.48 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "e93f9c0d-1efc-5540-8131-742ffaec7cec")
	)
	(text "This schematic is generated by pcb_v2/gen/rx2_sch.py from the simulation blocks fm_receiver_v2/simulations/rx2_blk_*.inc."
		(exclude_from_sim no)
		(at 205 49.68 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "4b9c7d44-0098-56a6-b0a2-ce340b3ed31d")
	)
	(text "Net names are the node names of the simulation. Under each value stands the part's name in the simulation (field Sim)."
		(exclude_from_sim no)
		(at 205 53.28 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "fdca3fb0-3086-577c-860a-6aa52889f65f")
	)
	(text "Reference numbers: sheet number x 100 + running number, in the order of the block file."
		(exclude_from_sim no)
		(at 205 56.88 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "8abcca2a-1a20-5573-939b-e0ea0180a664")
	)
	(text "pcb_v2/gen/rx2_check.py compares the exported netlist with the blocks: parts, values, connections, footprints, LCSC numbers."
		(exclude_from_sim no)
		(at 205 60.48 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "60a38b9d-f85a-5682-a16b-66fa02a561bb")
	)
	(text "Board: 2 layers, at most 100 x 100 mm, all parts on the top side, unbroken ground under both IF strips."
		(exclude_from_sim no)
		(at 205 67.68 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "aadc38c3-06c7-5266-a0b3-8f0a39f01326")
	)
	(text "Layout rules from the design log (each one is repeated on the sheet it applies to):"
		(exclude_from_sim no)
		(at 205 71.28 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "78a994c9-7762-5355-9dfc-65af4fb8165b")
	)
	(text "1  each IF strip in a straight line, input at one end, output at the other"
		(exclude_from_sim no)
		(at 205 74.88 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "d7c70be4-9280-53d4-80ce-3a35cd79a720")
	)
	(text "2  first IF: T2 and T4 15 to 20 mm apart, neighbouring inductors at right angles, ground and vias between stages"
		(exclude_from_sim no)
		(at 205 78.48 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "3ac3722d-5760-55af-b24c-8f86a5c00915")
	)
	(text "3  second IF: node c2 and the detector 25 mm or more from T5 / L5; c2 and x short; L5 and L6 apart and at right angles"
		(exclude_from_sim no)
		(at 205 82.08 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "53206f74-e71a-5e2c-8f88-8c384f484563")
	)
	(text "4  squarer: node eq as small as possible, under 1 pF"
		(exclude_from_sim no)
		(at 205 85.68 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "4389e07d-cab9-51a4-b3bd-15684677f80e")
	)
	(text "5  Cadc at the DevKitC pin, away from T6 and c2"
		(exclude_from_sim no)
		(at 205 89.28 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "509c0e4d-3d1e-5be0-b402-f4bf86b957e9")
	)
	(text "6  a spare capacitor position on every tuned circuit (11 in all, not fitted)"
		(exclude_from_sim no)
		(at 205 92.88 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "77c5fcf2-7f6f-5fa4-8ac4-458f300b9e5f")
	)
	(text "7  pump driver and detector 50 mm or more from the first-IF tuned circuits (self-lock at LO2 / 10)"
		(exclude_from_sim no)
		(at 205 96.48 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "16d63289-bf29-582e-84ff-38ed218ca0d6")
	)
	(text "8  squarer: the collector of Qq1 within about 4 mm of its bypass capacitor Cfq2"
		(exclude_from_sim no)
		(at 205 100.08 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
