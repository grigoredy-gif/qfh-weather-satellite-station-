		(uuid "656d0840-e108-5836-9cf7-8b9b4eb72fe7")
	)
	(text "Rule 5: Cadc (sheet 9) sits at pin 3 of the left DevKitC socket."
		(exclude_from_sim no)
		(at 15.24 27.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6e5e8fd7-1d70-5128-a547-42619950b2e9")
	)
	(text "3.3 V rail: discrete regulator that copies the DevKitC's 3V3 pin"
		(exclude_from_sim no)
		(at 15.24 32.16 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "cfe0f87b-eeb4-552a-b052-d63b1772cd13")
	)
	(text "Nodes: v5 (DevKitC 5V pin, 4.2 to 5 V), v3ref (DevKitC 3V3 pin), vcc (receiver rail, about 3.28 V)"
		(exclude_from_sim no)
		(at 15.24 36.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "557e0483-5b1a-5e74-927d-7ebec645bbcc")
	)
	(text "The power comes from the 5V pin through the PNP pass transistor Qrp. The voltage is set by the 3V3 pin,"
		(exclude_from_sim no)
		(at 15.24 39.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8fe1af7c-bb0a-5189-9819-7f5702bf7d33")
	)
	(text "filtered by Rr1 and Cr (7 Hz), so the ESP32's own supply noise does not reach the receiver."
		(exclude_from_sim no)
		(at 15.24 42.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "60cd2c79-b0d2-50da-a132-8709bfd9da13")
	)
	(text "Qre1 and Qre2 compare the rail with that reference and drive Qrp. Rrs and Qrl limit the current to about 65 mA."
		(exclude_from_sim no)
		(at 15.24 45.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b65d61a6-b7c0-52b3-b1af-1114881da968")
	)
