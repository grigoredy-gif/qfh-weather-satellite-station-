	(text "pair C, pump driver, tail 1.6 mA: square wave of about 1.65 V at c2. Its bases hang on vbd, not on vb:"
		(exclude_from_sim no)
		(at 15.24 231.78 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "e4e2b42b-a4ff-50ba-a355-a4edf06c1df8")
	)
	(text "vbd follows the two junction drops the charge pump loses, so the detector output does not drift with temperature."
		(exclude_from_sim no)
		(at 15.24 236.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3de01331-cf47-56c2-acb4-8a973c0bfbd9")
	)
	(text "Its reference base goes to vbd through only 470 ohm, so the square-wave height does not depend on transistor gain."
		(exclude_from_sim no)
		(at 15.24 239.08 0)
		(effects
