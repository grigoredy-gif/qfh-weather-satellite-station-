	(text "Layout rules for this sheet (from the design log)"
		(exclude_from_sim no)
		(at 15.24 22.86 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "5e7a4ccd-c555-59d5-95c8-fb83da8c4387")
	)
	(text "Rule 1: the strip runs in a straight line, T5 / L5 at one end, the pump driver (pair C) and the detector at the other."
		(exclude_from_sim no)
		(at 15.24 27.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a63cf097-91b5-5a5a-8496-03b82fe88ecf")
	)
	(text "Rule 3: node 'c2' carries a 1.65 V square wave and 0.005 pF from 'c2' to T5 closes the loop: keep pair C and the detector"
		(exclude_from_sim no)
		(at 15.24 30.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ae102293-5812-5bc3-a642-1a81fb75cb2f")
	)
	(text "        25 mm or more from T5 / L5, solid ground under and between, 'c2' and 'x' as short as possible,"
		(exclude_from_sim no)
		(at 15.24 32.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "30d2fb61-1d83-5f99-8314-530d68951f01")
	)
	(text "        L5 and L6 apart and at right angles (coupling factor under 0.007), T6 to T5 under 1 pF."
		(exclude_from_sim no)
		(at 15.24 35.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d2d78f19-7933-5907-b4ca-60d7a8b2b818")
	)
	(text "Ground: unbroken under the whole strip (the board has 2 layers)."
		(exclude_from_sim no)
		(at 15.24 38.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c68a8d93-0749-5f44-abac-89e9cfecb211")
	)
	(text "Rule 6: spare capacitor positions on T5 and T6 (value 'spare', not fitted)."
		(exclude_from_sim no)
		(at 15.24 41.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d580b4ba-ac54-532b-af1a-ad3ea5778809")
	)
	(text "Rule 7: pair C and the detector 50 mm or more from the first-IF tuned circuits (sheet 5), unbroken ground between:"
		(exclude_from_sim no)
		(at 15.24 44.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "80a7cd09-e005-57db-952a-5e2bbbc04a60")
	)
	(text "        the 9th harmonic of c2 lies in the first IF, and the second IF can lock itself at LO2 / 10 = 1.4318 MHz."
		(exclude_from_sim no)
		(at 15.24 46.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2e1b9ec7-2f91-5936-a712-498db07eff70")
	)
	(text "Second-IF strip at 1.418 MHz: tuned circuit T5, pair A + tuned circuit T6, limiter pair B,"
		(exclude_from_sim no)
		(at 15.24 51.76 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "05513d85-dba3-53b4-b2c6-926588b82f83")
	)
	(text "pump-driver pair C, charge-pump detector."
		(exclude_from_sim no)
		(at 15.24 56.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "39273700-59e9-51f8-947b-393c818376e1")
	)
	(text "Nodes: vcc (3.3 V rail), t5 (input: collector of mixer 2 feeds this tuned circuit), det (detector output),"
		(exclude_from_sim no)
		(at 15.24 59.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "07fc68a1-51ef-57ac-9a96-069b3a203fe9")
	)
	(text "vb and vbd (the two references from rx2_blk_bias.inc)"
		(exclude_from_sim no)
		(at 15.24 61.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5b6f0ae8-dad4-5522-8916-b05c4e3a636e")
	)
	(text "T5: 100 uH (Q 30 at 1.4 MHz, 4 pF self-capacitance) with 100 pF + 4.7 pF; T6 the same with 100 pF + 6.8 pF."
		(exclude_from_sim no)
		(at 15.24 64.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "59128c86-11f2-53fb-930b-8daf6a7e82a8")
	)
	(text "The small capacitors centre the pair on 1.418 MHz with the second mixer connected and 1 pF of board stray"
		(exclude_from_sim no)
		(at 15.24 67.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "21de98bd-0552-522d-acd5-4294c1bdce6c")
	)
	(text "on each tuned circuit (Ct5_x, Ct6_x: layout estimates, not parts)."
		(exclude_from_sim no)
		(at 15.24 70.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9b8265fe-5685-51bc-8b39-289362ffaf38")
	)
