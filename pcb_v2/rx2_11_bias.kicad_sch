	(text "The two bias references"
		(exclude_from_sim no)
		(at 15.24 22.86 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "8d516666-342f-53f7-b655-0ce0ccfd31f6")
	)
	(text "Nodes: vcc, vb, vbd"
		(exclude_from_sim no)
		(at 15.24 27.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "099f15ae-8f6f-5ce4-ad35-ffa1f907c626")
	)
	(text "vb (about 1.17 V): shared by every emitter-coupled pair, both mixers and the squarer's current source."
		(exclude_from_sim no)
		(at 15.24 30.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "db2f018b-dffa-58c2-a1d9-eba8e26b9fbf")
	)
	(text "One MMBT3904 connected as a diode on top of a 270 ohm resistor. The voltage across a stage's tail resistor is"
		(exclude_from_sim no)
		(at 15.24 32.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8d0551cd-6636-5659-8d36-e802c6ce6d3e")
	)
	(text "vb minus one base-emitter drop, so the two junction drops cancel and what is left is the resistor drop"
		(exclude_from_sim no)
		(at 15.24 35.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ee8aa13b-2151-5e87-92ea-2984b4edaf1e")
	)
	(text "(about 0.5 V, a fixed fraction of the rail). Stage currents hold within a few percent over temperature."
		(exclude_from_sim no)
		(at 15.24 38.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e2074685-fc01-5096-b7f9-cc347caa8aca")
	)
	(text "vbd (about 1.27 V): for the pump driver (pair C in rx2_blk_if2.inc) only. An MMBT3904 and an MMBT3906 as diodes"
		(exclude_from_sim no)
		(at 15.24 41.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2d3a0c9c-0079-50e5-aeac-b0fe140bfffd")
	)
	(text "in series. The charge pump loses two junction drops per cycle (its Schottky diode and its PNP), and those"
		(exclude_from_sim no)
		(at 15.24 44.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "08ae6966-225d-5c0d-ab4c-04cb0f66000a")
	)
	(text "drops fall as the board warms up. vbd falls with them, so the square wave shrinks by the same amount and"
		(exclude_from_sim no)
		(at 15.24 46.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "28ae8a40-eb63-5223-a9a2-85652c86ab6a")
	)
	(text "the detector output stays where it is."
		(exclude_from_sim no)
		(at 15.24 49.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "764cf831-e878-5340-9532-dd0c619a4442")
	)
