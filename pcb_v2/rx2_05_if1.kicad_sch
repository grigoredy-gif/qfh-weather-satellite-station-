		)
	)
	(text "Layout rules for this sheet (from the design log)"
		(exclude_from_sim no)
		(at 15.24 22.86 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "c1a32a09-e18f-553f-a38b-59957b39906b")
	)
	(text "Rule 1: the strip runs in a straight line, T1 at one end and T4 at the other; nothing from the output side runs back along it."
		(exclude_from_sim no)
		(at 15.24 27.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "90fb9ac1-e871-5830-93e7-906009003b76")
	)
	(text "Rule 2: T2 and T4 at least 15 to 20 mm apart; neighbouring inductors at right angles; ground pour and vias between the stages;"
		(exclude_from_sim no)
		(at 15.24 30.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fab5cba6-a1c4-50ef-a926-9b9f1148791a")
	)
	(text "        input and output of each pair apart (0.5 pF across pair 2 is fine, 1 pF oscillates)."
		(exclude_from_sim no)
		(at 15.24 32.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "05d756c2-014a-59a8-9ab0-7ee61120828f")
	)
	(text "        The strip tolerates 0.1 pF from T4 back to T2 and a coupling factor of 0.002 between Lt2 and Lt4."
		(exclude_from_sim no)
		(at 15.24 35.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d371bc3e-9ceb-5ef1-ba1b-1863504d8467")
	)
	(text "Ground: unbroken under the whole strip (the board has 2 layers)."
		(exclude_from_sim no)
		(at 15.24 38.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8933dc0f-7bea-5d15-9144-a0e46799c498")
	)
	(text "Rule 6: spare capacitor positions on T1 to T4 (value 'spare', not fitted)."
		(exclude_from_sim no)
		(at 15.24 41.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "77d64d47-46e9-5075-aaef-ef3ae0cfec5b")
	)
	(text "Rule 7: the pump driver and the detector of the second IF (sheet 8) stay 50 mm or more from T1 to T4."
		(exclude_from_sim no)
		(at 15.24 44.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "69379ad3-381e-5b92-88d7-09952caa4072")
	)
	(text "First-IF strip at 12.9 MHz: four wide tuned circuits and two emitter-coupled pairs"
		(exclude_from_sim no)
		(at 15.24 48.96 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "20aa5098-62f6-55a5-a57d-042c06a74320")
	)
	(text "Nodes: t1 (input: collector of mixer 1 feeds tuned circuit T1), m2in (output: tuned circuit T4, feeds mixer 2), vcc, vb"
		(exclude_from_sim no)
		(at 15.24 53.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "602b91d8-fb07-5d07-9b23-015e3a4facc7")
	)
	(text "Each tuned circuit: 3.3 uH +-5 % 1008 wirewound (LCSC C6364740: Q 22 at 25 MHz, SRF 110 MHz; Q 16 at 12.9 MHz assumed)."
		(exclude_from_sim no)
		(at 15.24 56.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1e3e983d-c4e1-56b9-89c4-b98b0c68f537")
	)
	(text "The loading is light (10 kohm), so the loaded Q is about 7 to 10 and follows the Q of the inductor (12 to 20)."
		(exclude_from_sim no)
		(at 15.24 59.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e0d098c0-9c09-5e49-aa42-a92045087534")
	)
	(text "The strip only has to reject the second image at 15.736 MHz; the bandwidth is set later, at 1.418 MHz."
		(exclude_from_sim no)
		(at 15.24 61.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1572779f-c043-5707-8da4-35e54259810b")
	)
	(text "The pairs use the S9018 (QIF), not the MMBT3904: a 3904 pair adds about 10 pF to a 46 pF"
		(exclude_from_sim no)
		(at 15.24 64.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f3809261-c9d1-5a5c-aeca-2d082548205e")
	)
	(text "tuned circuit, and that capacitance is not well controlled (the slow-corner 3904 moved the strip 0.3 MHz low)."
		(exclude_from_sim no)
		(at 15.24 67.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "dc4e9bd8-35fa-55ba-b070-94540c012c85")
	)
	(text "T1 (load of mixer 1) and T2, coupled through the shared 330 pF capacitor Cm12 (bottom coupling: it gets weaker"
		(exclude_from_sim no)
		(at 15.24 70.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "080b5f18-9ea2-52ff-af6d-4991234552bd")
	)
	(text "above resonance, which is where the second image is; a small top capacitor would favour the low side instead)"
		(exclude_from_sim no)
		(at 15.24 73.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "650f79f9-a19c-59ef-96e5-2423bd7a538c")
	)
