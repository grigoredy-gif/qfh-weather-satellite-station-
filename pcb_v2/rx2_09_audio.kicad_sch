	(text "Layout rules for this sheet (from the design log)"
		(exclude_from_sim no)
		(at 15.24 22.86 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "c49fea57-4155-510d-b975-a164b0071b3e")
	)
	(text "Rule 5: Cadc sits at the DevKitC pin (GPIO36 = pin 3 of the left socket, sheet 10), away from T6 and node 'c2'."
		(exclude_from_sim no)
		(at 15.24 27.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "63ffbc64-710d-5144-b569-13b48c3c2d13")
	)
	(text "Audio chain: buffer, 4th-order low-pass (two Sallen-Key sections), gain stage, ADC interface"
		(exclude_from_sim no)
		(at 15.24 32.16 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "047ca123-b9a2-5122-a4cb-5cfddbb845f8")
	)
	(text "Nodes: det (detector output: 1.27 V DC, 27 kohm source, about 10 mV peak of audio), adc (to ESP32 GPIO36), vcc"
		(exclude_from_sim no)
		(at 15.24 36.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9ae0483b-cc2d-537d-9c2b-f1317c4ed96f")
	)
	(text "Followers alternate PNP / NPN / PNP so the DC level steps up, down, up and nothing needs a coupling capacitor"
		(exclude_from_sim no)
		(at 15.24 39.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5645d8e9-7c24-52f0-a79c-916a445141cd")
	)
	(text "until the gain stage. The gain stage is AC-coupled on both sides, so its own DC drift does not reach the ADC."
		(exclude_from_sim no)
		(at 15.24 42.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ef48c1fe-501b-53c5-86b4-805febb5163e")
	)
	(text "Gain stage: base at 1.45 V, emitter at 0.8 V, collector at about 1.7 V, so it has room to swing both ways at"
		(exclude_from_sim no)
		(at 15.24 45.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f605071c-7540-51cb-929c-0e06333e6efa")
	)
	(text "every corner. The rest level at the ADC pin (1.25 V) comes from the filtered audio supply va, not from the"
		(exclude_from_sim no)
		(at 15.24 47.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "033b2574-dcc3-5d6c-ab75-966bf4514c4f")
	)
	(text "3V3 pin: ripple on that pin would otherwise reach the ADC only 26 dB down."
		(exclude_from_sim no)
		(at 15.24 50.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "96fa782c-a291-55aa-a525-b97194cf8ca8")
	)
